doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    link(rel="stylesheet", href="/style.css")
    title Posts
  body
    header
      h1 /posts
    .container
      if posts.length
        each post in posts
          .post
            .post-header
              img(src="/images/1415537875.jpg", alt="chico")
            .post-body
              span #{post.author} • #{new Intl.DateTimeFormat('en-GB', {day: '2-digit',month: 'short',year: 'numeric',}).format(new Date(post.createdAt))}
              h3 #{post.title}
              p #{post.content}
              ul.post-tags
                each tag in post.tags
                  li #{tag}
      else
        p Nenhum post publicado
