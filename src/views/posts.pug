doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    link(rel="stylesheet", href="/styles/global.css")
    link(rel="stylesheet", href="/styles/posts.css")
    title Posts
  body
    header
      h1 /posts
    .container
      if posts.length
        each post in posts
          .post(onclick=`window.location='/posts/${post.id}'`)
            .post-header
              img(src="/images/example.avif", alt="chico")
            .post-body
              span #{post.authorName} • #{new Intl.DateTimeFormat('en-GB', {day: '2-digit',month: 'short',year: 'numeric',}).format(new Date(post.createdAt))}
              h3 #{post.title}
              p #{post.content}
              ul.post-tags
                each tag in post.tags
                  li #{tag}
      else
        span.warning Nenhum post publicado
