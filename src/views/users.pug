doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    link(rel="stylesheet", href="/styles/global.css")
    link(rel="stylesheet", href="/styles/users.css")
    title Users
  body
    header
      h1 /users
    .container
      .main
        h2.title Todos os usuários
          span #{users.length}
        .table
          .table-header
            .col.name Nome do usuário/E-mail
            .col.access Cargo
            .col.last Atualizado em
            .col.added Adicionado em
          if users.length
            each user in users
              .row(onclick=`window.location='/users/${user.id}'`)
                .col.name
                  .avatar
                    span= user.name.charAt(0)
                  .info
                    .username #{user.name}
                    .email #{user.email}

                .col.access
                  span(class=`badge ${user.role}`)= user.role

                .col.last #{new Intl.DateTimeFormat('en-GB', {day: '2-digit',month: 'short',year: 'numeric',}).format(new Date(user.updatedAt))}
                .col.added #{new Intl.DateTimeFormat('en-GB', {day: '2-digit',month: 'short',year: 'numeric',}).format(new Date(user.createdAt))}
          else
            p Nenhum usuário cadastrado
